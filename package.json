{
  "name": "jira-viewer",
  "version": "1.0.0",
  "description": "Jira 이슈 조회 및 상태관리를 위한 Electron 데스크톱 앱",
  "main": "src/main/main.js",
  "author": "",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:css": "tailwindcss -i ./src/renderer/tailwind.css -o ./src/renderer/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/renderer/tailwind.css -o ./src/renderer/styles.css --watch",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.11"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3"
  },
  "build": {
    "appId": "com.wecostay.jiraviewer",
    "productName": "Jira Viewer",
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@github/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "build/icon.png",
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
